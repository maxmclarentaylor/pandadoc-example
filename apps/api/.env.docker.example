# Optional extra env for Compose. The API service loads apps/api/.env, which
# holds the Azure DATABASE_URL (same file the host venv uses).
# Keep Entra values in sync with .env.example / Azure app registration.

# Entra ID (Microsoft identity platform) — caller JWT validation
AZURE_TENANT_ID=c97ce120-adbc-4e5b-b458-5acbac0bc05f
AZURE_API_CLIENT_ID=a4f8ea2d-a323-4974-96f2-f796ea0b18c0
# AZURE_API_AUDIENCE=api://a4f8ea2d-a323-4974-96f2-f796ea0b18c0

# Optional: Application Insights (leave unset for quieter local runs)
# APPLICATIONINSIGHTS_CONNECTION_STRING=
